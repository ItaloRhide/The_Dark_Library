DATABASE_URL=postgresql://user:password@localhost:5432/dark_library
PORT=3000

# --- Auth ---
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRES_IN=7d

# Admin (criado automaticamente no startup se não existir)
ADMIN_EMAIL=seuemail@gmail.com
ADMIN_PASSWORD=sua-senha-forte

# --- Email (Gmail SMTP — use uma App Password) ---
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-app-password-do-gmail

# --- Supabase Storage (produção) ---
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...sua-service-role-key